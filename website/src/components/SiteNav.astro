---
import { Menu, Search as SearchIcon, X } from "@lucide/astro";
import type { NavGroup } from "../lib/navigation";
import { DISCORD_URL, GITHUB_URL } from "../lib/site";
import BrandIcon from "./BrandIcon.astro";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
	/** On docs pages the small-screen menu also lists the docs being shown: their sidebar, and the URL prefix of that set of docs. */
	docs?: { sidebar: NavGroup[]; base: string };
}

const { docs } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const current = (href: string) => (path === href ? "page" : undefined);

const links = [
	{ label: "docs", href: "/overview" },
	{ label: "install", href: "/getting-started/installation" },
	{ label: "hotkeys", href: "/list/hotkey-list" },
	{ label: "changelog", href: "/changelog" }
];

// The small-screen menu: the same links, plus the two places people talk.
const menuLinks = [{ label: "home", href: "/" }, ...links, { label: "github", href: GITHUB_URL }, { label: "discord", href: DISCORD_URL }];
---

<div class="bar">
	<header class="nav sf-wrap">
		<a class="brand" href="/" aria-label="superfile home">
			<img src="/logo.svg" alt="" width="32" height="26" />
			<span>superfile</span>
		</a>
		<nav class="links" aria-label="Main">
			{
				links.map(link => (
					<a href={link.href} aria-current={current(link.href)}>
						{link.label}
					</a>
				))
			}
		</nav>
		<div class="tools">
			<button class="sf-btn sf-btn--sm search" type="button" aria-label="Search the docs" aria-haspopup="dialog" data-search-open>
				<SearchIcon aria-hidden="true" />
				<span>search docs</span>
				<kbd class="sf-kbd">/</kbd>
			</button>
			<div class="wide-only"><ThemeToggle /></div>
			<a class="sf-btn sf-btn--sm wide-only" href={GITHUB_URL} aria-label="superfile on GitHub" data-stars>
				<BrandIcon name="github" />
				<span>github</span>
			</a>
			<button class="sf-btn sf-btn--sm menu-toggle" type="button" aria-label="Menu" popovertarget="site-menu">
				<Menu aria-hidden="true" />
				<X aria-hidden="true" />
			</button>
		</div>
	</header>
</div>

<!-- Small screens: the menu comes down over the page like a curtain, one terminal row at a time. -->
<div class="menu" id="site-menu" popover data-pagefind-ignore>
	<div class="menu__inner sf-wrap">
		<p class="menu__label"><b>$</b> ls ~/superfile</p>
		<nav aria-label="Menu">
			<ul>
				{
					menuLinks.map((link, index) => (
						<li style={`--i:${index}`}>
							<a class="menu__link" href={link.href} aria-current={current(link.href)}>
								<span>{String(index).padStart(2, "0")}</span>
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
		{
			docs && (
				<nav class="menu__docs" aria-label="Docs" style={`--i:${menuLinks.length}`}>
					{docs.sidebar.map(group => (
						<div>
							<p class="menu__label">
								<b>//</b> {group.label}
							</p>
							<ul>
								{group.items.map(item => (
									<li>
										<a class="menu__sublink" href={`${docs.base}/${item.slug}`} aria-current={current(`${docs.base}/${item.slug}`)}>
											{item.label}
										</a>
									</li>
								))}
							</ul>
						</div>
					))}
				</nav>
			)
		}
		<div class="menu__foot" style={`--i:${menuLinks.length + 1}`}>
			<span>theme</span>
			<ThemeToggle />
		</div>
	</div>
</div>

<style>
	.bar {
		position: sticky;
		top: 0;
		z-index: 50;
		border-bottom: 1px solid transparent;
		background: var(--bg);

		/* A rule appears under the nav once the page has scrolled. */
		&[data-scrolled] {
			border-bottom-color: var(--line);
		}
	}
	.nav {
		display: flex;
		align-items: center;
		gap: var(--space-5);
		height: var(--nav-h);
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		color: var(--ink);
		font: 600 20px/1 var(--font-mono);
		letter-spacing: -0.02em;
		text-decoration: none;
	}
	.links {
		display: flex;
		gap: 6px;

		& a {
			padding: 8px 10px;
			border-radius: 4px;
			color: var(--ink-muted);
			font: 500 16px/1 var(--font-mono);
			text-decoration: none;

			&[aria-current] {
				color: var(--ink);
			}
			&:hover {
				background: var(--ink);
				color: var(--bg);
			}
		}
	}
	.tools {
		display: flex;
		align-items: center;
		gap: 10px;
		margin-inline-start: auto;
	}
	.wide-only {
		display: inline-flex;
	}
	.search {
		justify-content: flex-start;
		width: 260px;
		padding: 0 8px 0 14px;
		color: var(--ink-muted);

		& span {
			flex: 1;
			text-align: left;
		}
		& .sf-kbd {
			min-width: 26px;
			height: 26px;
			padding: 0 6px;
			color: inherit;
		}
		&:hover .sf-kbd {
			border-color: currentColor;
		}
	}
	[data-stars] span {
		min-width: 3ch;
	}
	.menu-toggle {
		display: none;
		width: 42px;
		padding: 0;

		/* It shows the menu icon, and the close icon while the menu is open. */
		& :global(.lucide-x),
		.bar:has(+ .menu:popover-open) & :global(.lucide-menu) {
			display: none;
		}
		.bar:has(+ .menu:popover-open) & {
			background: var(--ink);
			color: var(--bg);
			border-color: var(--ink);

			& :global(.lucide-x) {
				display: block;
			}
		}
	}

	@media (max-width: 1180px) {
		.search {
			width: 200px;
		}
	}
	@media (max-width: 1040px) {
		.search {
			justify-content: center;
			width: 42px;
			padding: 0;

			& span,
			& .sf-kbd {
				display: none;
			}
		}
	}
	@media (max-width: 900px) {
		.nav {
			gap: var(--space-3);
		}
		.tools {
			gap: 8px;
		}
		.links,
		.wide-only {
			display: none;
		}
		.menu-toggle {
			display: inline-flex;
		}
		/* The page behind the open menu does not scroll. */
		:global(html:has(#site-menu:popover-open)) {
			overflow: hidden;
		}
	}
	@media (max-width: 620px) {
		.brand {
			gap: 10px;
			font-size: 18px;
		}
	}

	/* The menu is a charcoal screen that comes down from under the nav in steps, the way a terminal
	   draws line by line; then its rows print one after another. */
	.menu {
		position: fixed;
		inset: var(--nav-h) 0 0;
		width: auto;
		height: auto;
		margin: 0;
		padding: 0;
		overflow-y: auto;
		overscroll-behavior: contain;
		border: 0;
		background: var(--term-bg);
		color: var(--term-ink);
		clip-path: inset(0 0 100% 0);
		transition: 280ms steps(12, end) allow-discrete;
		transition-property: clip-path, display, overlay;

		&:popover-open {
			clip-path: inset(0);
			transition-duration: 420ms;
			transition-timing-function: steps(14, end);

			@starting-style {
				clip-path: inset(0 0 100% 0);
			}
		}
		/* The curtain's leading edge: one orange row, like the cursor line that draws it. */
		&::after {
			content: "";
			position: sticky;
			bottom: 0;
			display: block;
			height: 4px;
			background: var(--signal);
		}
		& :focus-visible {
			outline-color: var(--term-teal);
		}
		& ul {
			margin: 0;
			padding: 0;
			list-style: none;
		}
		@media (prefers-reduced-motion: reduce) {
			transition: none;
		}
		@media (min-width: 901px) {
			display: none;
		}
	}
	.menu__inner {
		min-height: calc(100% - 4px);
		padding-top: var(--space-6);
		padding-bottom: var(--space-7);
	}
	.menu__label {
		margin: 0 0 var(--space-4);
		font: 500 15px/1.4 var(--font-mono);
		color: var(--term-muted);

		& b {
			color: var(--term-signal);
			font-weight: 600;
		}
		.menu__docs & {
			margin-bottom: var(--space-2);
		}
	}
	.menu__link,
	.menu__sublink {
		border-radius: var(--radius-xs);
		color: var(--term-ink);
		text-decoration: none;

		&:is(:hover, :active, [aria-current]) {
			background: var(--term-ink);
			color: var(--term-bg);
		}
	}
	.menu__link {
		display: flex;
		align-items: baseline;
		gap: 16px;
		margin-inline: -12px;
		padding: 10px 12px;
		font: 600 clamp(28px, 8vw, 40px) / 1.15 var(--font-mono);
		letter-spacing: -0.03em;

		/* Its number in the list. */
		& span {
			font: 500 15px/1 var(--font-mono);
			letter-spacing: 0;
			color: var(--term-muted);
		}
		&:is(:hover, :active, [aria-current]) span {
			color: var(--signal-text);
		}
	}
	.menu__sublink {
		display: block;
		margin-inline: -10px;
		padding: 7px 10px;
		font: 400 16px/1.35 var(--font-mono);
	}
	.menu__docs {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--space-6) var(--space-5);
		margin-top: var(--space-7);
		padding-top: var(--space-6);
		border-top: 1px solid var(--term-line);
	}
	.menu__foot {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-top: var(--space-7);
		padding-top: var(--space-5);
		border-top: 1px solid var(--term-line);
		font: 500 15px/1 var(--font-mono);
		color: var(--term-muted);

		/* The theme toggle sits on a screen here, so it takes the screen's colours. */
		--box: var(--term-line);
		--ink-muted: var(--term-muted);
		--ink: var(--term-ink);
		--bg: var(--term-bg);
	}
	/* Rows print one after another once the curtain is down. */
	@media (prefers-reduced-motion: no-preference) {
		.menu:popover-open :is(.menu__inner > .menu__label, li[style], .menu__docs, .menu__foot) {
			animation: print 1ms steps(1, end) both;
			animation-delay: calc(160ms + var(--i, 0) * 55ms);
		}
	}
	@keyframes print {
		from {
			opacity: 0;
		}
	}
</style>

<script>
	import { getStars } from "../scripts/github-stats";

	const bar = document.querySelector(".bar")!;
	const markScrolled = () => bar.toggleAttribute("data-scrolled", scrollY > 8);
	addEventListener("scroll", markScrolled, { passive: true });
	markScrolled();

	const count = await getStars();
	const link = document.querySelector<HTMLElement>("[data-stars]");
	if (link && count !== null) {
		const stars = count >= 1000 ? `${(count / 1000).toFixed(1).replace(/\.0$/, "")}k` : String(count);
		link.querySelector("span")!.textContent = stars;
		link.ariaLabel = `superfile on GitHub, ${stars} stars`;
	}
</script>
