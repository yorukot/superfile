---
import { Search as SearchIcon } from "@lucide/astro";
---

<dialog class="sf-dialog" aria-label="Search the docs" data-search data-pagefind-ignore>
	<span class="sf-dialog__title" aria-hidden="true">search docs</span>
	<div class="inner">
		<div class="head">
			<span class="prompt" aria-hidden="true">/</span>
			<input
				type="text"
				role="combobox"
				aria-label="Search the docs"
				aria-controls="search-results"
				aria-expanded="false"
				aria-autocomplete="list"
				placeholder="type to search"
				enterkeyhint="search"
				autocomplete="off"
				autocapitalize="off"
				spellcheck="false"
			/>
			<SearchIcon aria-hidden="true" width="18" height="18" />
		</div>
		<div class="results" id="search-results" role="listbox" aria-label="Results"></div>
		<div class="foot">
			<span><span class="sf-keys"><kbd class="sf-kbd">↑</kbd><kbd class="sf-kbd">↓</kbd></span>move</span>
			<span><kbd class="sf-kbd">enter</kbd>open</span>
			<span><kbd class="sf-kbd">esc</kbd>close</span>
		</div>
	</div>
	<template data-search-hit>
		<a class="hit" role="option"><b></b><span></span></a>
	</template>
</dialog>

<style>
	.inner {
		display: flex;
		flex-direction: column;
		max-height: inherit;
	}
	.head {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 22px 18px 14px 26px;
	}
	.prompt {
		color: var(--signal-text);
		font-family: var(--font-mono);
		font-weight: 600;
	}
	input {
		flex: 1;
		min-width: 0;
		height: 44px;
		padding: 0;
		border: 0;
		outline: 0;
		background: transparent;
		color: var(--ink);
		font: 400 18px/1 var(--font-mono);

		&::placeholder {
			color: var(--ink-muted);
		}
	}
	.results {
		overflow-y: auto;
		padding: 0 8px;

		&:empty {
			display: none;
		}
		/* The "nothing found" line, written by the script. */
		& :global(p) {
			margin: 0;
			padding: 12px 18px;
			font: 400 16px/1.5 var(--font-mono);
			color: var(--ink-muted);
		}
	}
	.hit {
		display: block;
		padding: 12px 18px;
		border-radius: var(--radius-xs);
		color: var(--ink);
		text-decoration: none;

		& b {
			display: block;
			font: 600 16px/1.4 var(--font-mono);
		}
		& span {
			display: block;
			font-size: 16px;
			line-height: 1.5;
			color: var(--ink-muted);
		}
		/* Pagefind marks the words that matched. */
		& :global(mark) {
			background: none;
			color: var(--signal-text);
			font-weight: 600;
		}
		&:is(:hover, [aria-selected="true"]) {
			background: var(--ink);
			color: var(--bg);

			& span {
				color: inherit;
			}
			& :global(mark) {
				color: var(--signal);
			}
		}
	}
	.foot {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 22px;
		padding: 14px 26px 18px;
		font: 500 15px/1 var(--font-mono);
		color: var(--ink-muted);

		& span {
			display: inline-flex;
			align-items: center;
			gap: 8px;
		}
	}
</style>

<script>
	import { isTyping } from "../scripts/keyboard";

	interface Pagefind {
		init(): Promise<void>;
		/** Resolves to null when a newer search has started in the meantime. */
		debouncedSearch(query: string, options: object, debounceMs: number): Promise<{ results: { data(): Promise<{ url: string; excerpt: string; meta: { title?: string } }> }[] } | null>;
	}

	const dialog = document.querySelector<HTMLDialogElement>("[data-search]")!;
	const input = dialog.querySelector("input")!;
	const results = document.getElementById("search-results")!;
	const hitTemplate = dialog.querySelector<HTMLTemplateElement>("[data-search-hit]")!;

	// The index is written by `pagefind` after the build, so it does not exist in `astro dev`.
	const indexUrl = "/pagefind/pagefind.js";
	const unavailable = import.meta.env.DEV ? "The search index is built with the site. Run a build first." : "Search is not available right now. Try again in a moment.";
	let pagefind: Promise<Pagefind | null> | undefined;
	let failures = 0;
	// A load that failed is forgotten, so the next search tries again. The browser remembers that a
	// module failed to load, so a retry has to ask for it under another address.
	const loadPagefind = () =>
		(pagefind ??= import(/* @vite-ignore */ failures ? `${indexUrl}?retry=${failures}` : indexUrl)
			.then(async (module: Pagefind) => (await module.init(), module))
			.catch(() => {
				pagefind = undefined;
				failures++;
				return null;
			}));

	/** Marks one result as the one Enter opens. Focus stays in the input, so the input points a screen reader at it. */
	function select(hit: Element) {
		results.querySelector("[aria-selected='true']")?.setAttribute("aria-selected", "false");
		hit.ariaSelected = "true";
		input.setAttribute("aria-activedescendant", hit.id);
		hit.scrollIntoView({ block: "nearest" });
	}

	/** Puts results, a message or nothing in the list, with the first result selected. */
	function show(...content: Element[]) {
		results.replaceChildren(...content);
		const first = results.querySelector("[role='option']");
		input.ariaExpanded = String(!!first);
		if (first) select(first);
		else input.removeAttribute("aria-activedescendant");
	}

	const message = (text: string) => show(Object.assign(document.createElement("p"), { textContent: text }));

	async function search() {
		const query = input.value.trim();
		if (!query) return show();
		const engine = await loadPagefind();
		if (!engine) return message(unavailable);
		const found = await engine.debouncedSearch(query, {}, 140);
		if (!found) return;
		const hits = await Promise.all(found.results.slice(0, 8).map(result => result.data()));
		if (input.value.trim() !== query) return;
		if (!hits.length) return message(`Nothing found for "${query}".`);
		show(
			...hits.map((hit, index) => {
				const link = (hitTemplate.content.cloneNode(true) as DocumentFragment).querySelector("a")!;
				link.id = `search-hit-${index}`;
				link.href = hit.url;
				link.querySelector("b")!.textContent = hit.meta.title ?? hit.url;
				link.querySelector("span")!.innerHTML = hit.excerpt;
				return link;
			})
		);
	}

	function moveSelection(step: number) {
		const hits = [...results.querySelectorAll("[role='option']")];
		const next = hits[Math.max(0, Math.min(hits.length - 1, hits.findIndex(hit => hit.ariaSelected === "true") + step))];
		if (next) select(next);
	}

	function open() {
		if (dialog.open) return;
		dialog.showModal();
		void loadPagefind();
	}

	/**
	 * True for the `/` key. With an input method on (Zhuyin, Pinyin, kana…) the browser reports the
	 * key as "Process" or as the character the layout would type, so the physical key counts too.
	 */
	function isSlash(event: KeyboardEvent): boolean {
		if (event.key === "/") return true;
		if (event.code !== "Slash" || event.shiftKey) return false;
		return event.isComposing || event.key === "Process" || event.key === "Unidentified" || event.key.charCodeAt(0) > 127;
	}

	input.addEventListener("input", search);

	dialog.addEventListener("keydown", event => {
		// An input method uses these keys to pick a candidate. 229 marks its keys where `isComposing` does not.
		if (event.isComposing || event.keyCode === 229) return;
		if (event.key === "ArrowDown" || event.key === "ArrowUp") {
			event.preventDefault();
			moveSelection(event.key === "ArrowDown" ? 1 : -1);
		} else if (event.key === "Enter") {
			results.querySelector<HTMLElement>("[aria-selected='true']")?.click();
		}
	});
	// A click on the dialog element itself is a click on its backdrop.
	dialog.addEventListener("click", event => {
		if (event.target === dialog) dialog.close();
	});
	dialog.addEventListener("close", () => {
		input.value = "";
		show();
	});

	document.addEventListener("click", event => {
		if ((event.target as Element).closest("[data-search-open]")) open();
	});
	document.addEventListener("keydown", event => {
		const shortcut = (event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k";
		if (!shortcut && (!isSlash(event) || event.ctrlKey || isTyping(event))) return;
		event.preventDefault();
		open();
	});
</script>
