---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"ul"> {
	/** While the pointer is in the list, only the row under it is lit. */
	hoverMovesCursor?: boolean;
}

const { hoverMovesCursor = false, ...attrs } = Astro.props;
---

<ul class:list={["files", hoverMovesCursor && "files--hover-moves-cursor"]} {...attrs}><slot /></ul>

<style>
	.files {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.files--hover-moves-cursor:hover :global(.file[aria-current]:not(:hover)) {
		background: transparent;
		color: var(--ink);

		&::before {
			content: "";
		}
		:global(svg) {
			color: var(--ink-muted);
		}
		:global(.slash) {
			color: var(--teal-text);
		}
	}
</style>
