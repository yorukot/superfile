---
import About from "../components/home/About.astro";
import Changelog from "../components/home/Changelog.astro";
import Contributing from "../components/home/Contributing.astro";
import FilePanel from "../components/home/FilePanel.astro";
import Hotkeys from "../components/home/Hotkeys.astro";
import Install from "../components/home/Install.astro";
import Readme from "../components/home/Readme.astro";
import Themes from "../components/home/Themes.astro";
import Videos from "../components/home/Videos.astro";
import Base from "../layouts/Base.astro";
import { TAGLINE } from "../lib/site";

// The page is the project's folder, opened in superfile: a file panel on the left whose cursor
// follows the reader, and one "file" per question a visitor has on the right.
const files = [
	{ id: "readme", name: "README.md", Section: Readme },
	{ id: "videos", name: "videos", isDir: true, Section: Videos },
	{ id: "install", name: "install.sh", Section: Install },
	{ id: "hotkeys", name: "hotkeys.toml", Section: Hotkeys },
	{ id: "themes", name: "themes", isDir: true, Section: Themes },
	{ id: "about", name: "about.md", Section: About },
	{ id: "changelog", name: "CHANGELOG.md", Section: Changelog },
	{ id: "contributing", name: "CONTRIBUTING.md", Section: Contributing }
];
---

<Base title="superfile — terminal file manager" description={`${TAGLINE} Open source, written in Go, for Linux, macOS and Windows.`}>
	<main class="home sf-wrap" id="main">
		<FilePanel files={files} />
		<div>
			{files.map(({ id, Section }) => <Section id={id} />)}
		</div>
	</main>
</Base>

<style>
	.home {
		display: grid;
		grid-template-columns: 280px minmax(0, 1fr);
		column-gap: var(--space-7);
		align-items: start;
		padding-block: var(--space-5) var(--space-8);

		/* One column, without the file panel. */
		@media (max-width: 960px) {
			display: block;
			padding-top: 0;
		}
	}
</style>
