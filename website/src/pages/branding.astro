---
import { Download } from "@lucide/astro";
import logoDay from "../assets/superfile-day.svg";
import logoNight from "../assets/superfile-night.svg";
import Base from "../layouts/Base.astro";

const assets = [
	{
		title: "mark",
		description: "The folder on its own, for avatars, lists, badges and other small places.",
		href: "/logo.svg",
		download: "superfile-logo.svg",
		ground: "paper"
	},
	{
		title: "wordmark, light ground",
		description: "The mark with dark lettering, for light pages.",
		href: logoDay.src,
		download: "superfile-wordmark-light.svg",
		ground: "paper"
	},
	{
		title: "wordmark, dark ground",
		description: "The mark with light lettering, for dark pages.",
		href: logoNight.src,
		download: "superfile-wordmark-dark.svg",
		ground: "night"
	}
];

const usage = [
	"Keep the logo's proportions.",
	"Leave clear space around it so it does not touch nearby text or borders.",
	"Do not recolor, stretch, rotate or add effects to it.",
	"Pair it with the lowercase name: superfile."
];
---

<Base title="Brand assets | superfile" description="Download the superfile logo and wordmark, and see how to write the project's name.">
	<main class="sf-wrap" id="main">
		<p class="sf-label"><b>//</b> brand assets</p>
		<h1 class="sf-title">Download the superfile logo.</h1>
		<p class="sf-lede">Use these when you write about superfile, list it next to other projects, or link to the community.</p>

		<section class="section" aria-labelledby="brand-name">
			<p class="sf-label"><b>//</b> the name</p>
			<h2 class="sf-title" id="brand-name">Always lowercase.</h2>
			<div class="sf-panes block">
				<div class="sf-pane">
					<span class="sf-pane__title">write</span>
					<p class="name">superfile</p>
					<p class="sf-pane__body">One word, all lowercase, even at the start of a sentence. The command is <code class="sf-icode">spf</code>.</p>
				</div>
				<div class="sf-pane sf-pane--caution">
					<span class="sf-pane__title">avoid</span>
					<p class="sf-pane__body">Superfile, SuperFile or SUPERFILE, unless you are quoting a source that already wrote it that way.</p>
				</div>
			</div>
		</section>

		<section class="section" aria-labelledby="brand-files">
			<p class="sf-label"><b>$</b> ls logos/</p>
			<h2 class="sf-title" id="brand-files">The files.</h2>
			<div class="sf-panes block">
				{
					assets.map(asset => (
						<div class="sf-pane">
							<span class="sf-pane__title">{asset.title}</span>
							<div class={`preview preview--${asset.ground}`}>
								<img src={asset.href} alt="" />
							</div>
							<p class="sf-pane__body">{asset.description}</p>
							<a class="sf-btn sf-btn--sm" href={asset.href} download={asset.download}>
								<Download aria-hidden="true" />
								download svg
							</a>
						</div>
					))
				}
			</div>
		</section>

		<section class="section" aria-labelledby="brand-usage">
			<p class="sf-label"><b>//</b> usage</p>
			<h2 class="sf-title" id="brand-usage">A few rules.</h2>
			<ul class="rules">
				{usage.map(item => <li>{item}</li>)}
			</ul>
		</section>
	</main>
</Base>

<style>
	main {
		padding-block: var(--space-7) var(--space-8);
	}
	.section {
		margin-top: var(--space-8);
		padding-top: var(--space-8);
		border-top: 1px solid var(--box);
	}
	.block {
		margin-top: var(--space-7);
	}
	.name {
		margin: 0 0 var(--space-3);
		font: 600 clamp(40px, 7vw, 56px) / 1.05 var(--font-mono);
		letter-spacing: -0.045em;
		color: var(--ink);
	}
	/* Each logo is shown on the ground it was drawn for. When that is the site's own ground, an outline stands in for the fill. */
	.preview {
		display: grid;
		place-items: center;
		height: 180px;
		margin-bottom: var(--space-5);
		padding: var(--space-5);
		border-radius: var(--radius-sm);

		& img {
			width: auto;
			max-height: 72px;
		}
	}
	.preview--paper {
		background: light-dark(transparent, #efe8dd);
		box-shadow: inset 0 0 0 1px light-dark(var(--line), transparent);
	}
	.preview--night {
		background: light-dark(#303841, transparent);
		box-shadow: inset 0 0 0 1px light-dark(transparent, var(--line));
	}
	.sf-pane .sf-btn {
		margin-top: var(--space-5);
	}
	.rules {
		max-width: 40em;
		margin: 0;
		padding-left: 1.2em;
		color: var(--ink-muted);

		& li {
			margin: 0 0 10px;

			&::marker {
				color: var(--signal-text);
			}
		}
	}
</style>
