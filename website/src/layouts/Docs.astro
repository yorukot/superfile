---
import type { MarkdownHeading } from "astro";
import { resolveDocs } from "../../docs.config.mjs";
import Giscus from "../components/Giscus.astro";
import Pager from "../components/docs/Pager.astro";
import SidebarNav from "../components/docs/SidebarNav.astro";
import TableOfContents from "../components/docs/TableOfContents.astro";
import VersionNotice from "../components/docs/VersionNotice.astro";
import VersionSwitcher from "../components/docs/VersionSwitcher.astro";
import { discussionNumbers } from "../lib/comments";
import { getPrevNext, sidebarFor } from "../lib/navigation";
import "../styles/prose.css";
import Base from "./Base.astro";

interface Props {
	title?: string;
	description?: string;
	/** The page's path inside its set of docs: "getting-started/tutorial". */
	slug: string;
	headings: MarkdownHeading[];
	/** The set of docs this page belongs to: "latest", or a release tag such as "v1.5.0". */
	version: string;
	/** Every release tag that has docs. */
	tags: string[];
	/** The pages each set of docs has, keyed like `version`. */
	pages: Record<string, string[]>;
}

const { slug, headings, version, tags, pages, description } = Astro.props;
const title = Astro.props.title ?? headings.find(heading => heading.depth === 1)?.text ?? "superfile";
const docs = resolveDocs(tags);
const base = docs.prefix(version);
// The docs at the site root are the ones search engines, the site search and the comments belong to.
const isRoot = version === docs.root;

const sidebar = sidebarFor(pages[version]);
const group = sidebar.find(group => group.items.some(item => item.slug === slug));
const { prev, next } = getPrevNext(sidebar, slug);

// Switching version keeps the reader on the same page when the other version has it.
const hrefIn = (other: string) => {
	const has = pages[other];
	return `${docs.prefix(other)}/${has.includes(slug) ? slug : has.includes("overview") ? "overview" : has[0]}`;
};

// Links between docs pages are written as "/configure/…". Inside a set of docs that is not at the
// root they must stay in that set, so the rendered page gets its prefix put in front of them.
let body = await Astro.slots.render("default");
if (base) body = body.replace(/href="\/([^"#]*)(#[^"]*)?"/g, (whole, to, hash = "") => (pages[version].includes(to.replace(/\/$/, "")) ? `href="${base}/${to}${hash}"` : whole));

// Some pages open with an h1 that repeats the title; the layout already prints the title.
const repeatsTitle = headings[0]?.depth === 1 && headings[0].text.trim().toLowerCase() === title.trim().toLowerCase();
const toc = headings.filter((heading, index) => heading.depth <= 3 && !(index === 0 && repeatsTitle));
---

<Base title={`${title}${isRoot ? "" : ` (${version})`} | superfile`} description={description} docs={{ sidebar, base }}>
	{/* Only the docs at the root are for search engines. */}
	{!isRoot && <meta slot="head" name="robots" content="noindex" />}
	<div class="docs sf-wrap">
		<aside class="side">
			{tags.length > 0 && <VersionSwitcher version={version} groups={docs.groups} hrefFor={hrefIn} />}
			<SidebarNav groups={sidebar} current={slug} base={base} />
		</aside>

		<main id="main">
			{/* Only the docs at the root are searchable, so a search never lands on another version. */}
			<article data-pagefind-body={isRoot ? "" : undefined} data-pagefind-meta={isRoot ? `title:${title}` : undefined}>
				<header>
					{
						group && (
							<p class="sf-label">
								<b>//</b> {group.label}
							</p>
						)
					}
					<h1 class="sf-title">{title}</h1>
					{description && <p class="sf-lede">{description}</p>}
				</header>
				{docs.newest && version !== docs.newest && <VersionNotice version={version} newest={docs.newest} href={hrefIn(docs.newest)} />}
				<div class:list={["sf-prose", { "sf-prose--titled": repeatsTitle }]}>
					<Fragment set:html={body} />
				</div>
			</article>

			{(prev || next) && <Pager prev={prev} next={next} base={base} />}

			{
				isRoot && (
					<section class="comments" aria-label="Comments" data-pagefind-ignore>
						<p class="sf-label">
							<b>//</b> comments
						</p>
						<Giscus term={`${title} | superfile`} number={discussionNumbers[slug]} />
					</section>
				)
			}
		</main>

		{
			toc.length > 1 && (
				<aside class="toc" aria-label="On this page" data-pagefind-ignore>
					<TableOfContents headings={toc} />
				</aside>
			)
		}
	</div>
</Base>

<style>
	/* The sidebar on the left, the page in the middle, "on this page" on the right. */
	.docs {
		display: grid;
		grid-template-columns: var(--sidebar-w) minmax(0, 1fr) 200px;
		column-gap: var(--space-7);
		align-items: start;
		padding-block: var(--space-5) var(--space-8);

		@media (max-width: 1180px) {
			grid-template-columns: var(--sidebar-w) minmax(0, 1fr);
		}
		@media (max-width: 900px) {
			grid-template-columns: minmax(0, 1fr);
		}
	}
	.side,
	.toc {
		position: sticky;
		top: calc(var(--nav-h) + var(--space-4));
		max-height: calc(100vh - var(--nav-h) - var(--space-5));
		overflow-y: auto;
		scrollbar-width: thin;
		scrollbar-color: var(--box) transparent;
	}
	.side {
		padding-bottom: var(--space-5);

		/* The site menu lists the docs on small screens. */
		@media (max-width: 900px) {
			display: none;
		}
	}
	.toc {
		@media (max-width: 1180px) {
			display: none;
		}
	}
	main {
		justify-self: center;
		width: 100%;
		min-width: 0;
		max-width: 760px;
	}
	header {
		margin-bottom: var(--space-7);
	}
	.comments {
		margin-top: var(--space-8);
		padding-top: var(--space-7);
		border-top: 1px solid var(--box);
	}
</style>
